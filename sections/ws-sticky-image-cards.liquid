{% liquid
  assign content_max_width = section.settings.content_max_width | default: 'unset'
  assign block_count = section.blocks.size
  assign desktop_media_width = section.settings.desktop_media_width | default: 50
  assign desktop_content_width = 100 | minus: desktop_media_width
  assign image_sizes = '(min-width: 1024px) calc((100vw - 80px) * ' | append: desktop_media_width | append: ' / 100), calc(100vw - 32px)'
%}

<style>
  .ws-sticky-image-cards__background-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  .ws-sticky-image-cards-{{ section.id }} {
    --ws-sticky-image-cards-content-width: {{ desktop_content_width }}%;
    --ws-sticky-image-cards-media-width: {{ desktop_media_width }}%;
    --ws-sticky-image-cards-row-height: {{ section.settings.row_height }};
    --ws-sticky-image-cards-sticky-top: {{ section.settings.sticky_top }};
    --ws-sticky-image-cards-gap: {{ section.settings.gap }};
    --ws-sticky-image-cards-radius: {{ section.settings.border_radius }};
    --ws-sticky-image-cards-media-aspect-ratio: {{ section.settings.media_aspect_ratio }};
    --ws-sticky-image-cards-button-bg: {{ section.settings.button_background_color }};
    --ws-sticky-image-cards-button-text: {{ section.settings.button_text_color }};
    padding-top: {{ section.settings.padding_top_pc }};
    padding-bottom: {{ section.settings.padding_bottom_pc }};
    margin-top: {{ section.settings.margin_top_pc }};
    margin-bottom: {{ section.settings.margin_bottom_pc }};
  }

  .ws-sticky-image-cards-{{ section.id }} .ws-sticky-image-cards__inner {
    max-width: {{ content_max_width }};
  }

  @media (max-width: 749px) {
    .ws-sticky-image-cards-{{ section.id }} {
      --ws-sticky-image-cards-row-height: {{ section.settings.row_height_mobile }};
      --ws-sticky-image-cards-sticky-top: {{ section.settings.sticky_top_mobile }};
      padding-top: {{ section.settings.padding_top_mobile }};
      padding-bottom: {{ section.settings.padding_bottom_mobile }};
      margin-top: {{ section.settings.margin_top_mobile }};
      margin-bottom: {{ section.settings.margin_bottom_mobile }};
    }
  }
</style>

<div class="section-background ws-sticky-image-cards__background ws-sticky-image-cards__background-{{ section.id }}"></div>

<section
  class="section section--full-width ws-sticky-image-cards ws-sticky-image-cards-{{ section.id }} ws-sticky-image-cards--text-{{ section.settings.text_tone }}{% if section.settings.reverse_layout %} ws-sticky-image-cards--reverse{% endif %}"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  <div
    class="ws-sticky-image-cards__shell"
    {% if section.settings.section_id != blank %}
      id="{{ section.settings.section_id | escape }}"
    {% endif %}
  >
    <div class="ws-sticky-image-cards__inner">
      {% if block_count > 0 %}
        <div class="ws-sticky-image-cards__body">
          <div class="ws-sticky-image-cards__content" aria-hidden="false">
            {% for block in section.blocks %}
              <article class="ws-sticky-image-cards__text-panel" {{ block.shopify_attributes }}>
                <div class="ws-sticky-image-cards__text-inner">
                  {% if block.settings.description != blank %}
                    <div class="ws-sticky-image-cards__eyebrow">{{ block.settings.description }}</div>
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <h2 class="ws-sticky-image-cards__heading">{{ block.settings.heading }}</h2>
                  {% endif %}

                  {% if block.settings.button_label != blank %}
                    <div class="ws-sticky-image-cards__actions">
                      <a
                        class="ws-sticky-image-cards__button"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link"
                          aria-disabled="true"
                        {% endif %}
                        {% if block.settings.open_in_new_tab and block.settings.button_link != blank %}
                          target="_blank"
                          rel="noopener noreferrer"
                        {% endif %}
                      >
                        {{ block.settings.button_label }}
                      </a>
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>

          <div class="ws-sticky-image-cards__media-column">
            {% for block in section.blocks %}
              <article
                class="ws-sticky-image-cards__card"
                style="--ws-sticky-image-cards-card-index: {{ forloop.index }};"
                {{ block.shopify_attributes }}
              >
                <div class="ws-sticky-image-cards__card-sticky">
                  <div class="ws-sticky-image-cards__media-frame">
                    {% if block.settings.media_type == 'video' and block.settings.video != blank %}
                      {{
                        block.settings.video
                        | video_tag:
                          image_size: '1600x',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          playsinline: true,
                          controls: false,
                          class: 'ws-sticky-image-cards__media'
                      }}
                    {% elsif block.settings.media_type == 'video' and block.settings.video_url != blank %}
                      <video
                        class="ws-sticky-image-cards__media"
                        autoplay
                        loop
                        muted
                        playsinline
                      >
                        <source src="{{ block.settings.video_url | escape }}" type="video/mp4">
                      </video>
                    {% elsif block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1800
                        | image_tag:
                          loading: 'lazy',
                          widths: '480, 720, 900, 1080, 1296, 1600, 1800',
                          sizes: image_sizes,
                          class: 'ws-sticky-image-cards__media',
                          alt: block.settings.image.alt | default: block.settings.heading
                      }}
                    {% else %}
                      <div class="ws-sticky-image-cards__media ws-sticky-image-cards__media--placeholder">
                        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder' }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="ws-sticky-image-cards__mobile-text">
                    {% if block.settings.description != blank %}
                      <div class="ws-sticky-image-cards__eyebrow">{{ block.settings.description }}</div>
                    {% endif %}

                    {% if block.settings.heading != blank %}
                      <h2 class="ws-sticky-image-cards__heading">{{ block.settings.heading }}</h2>
                    {% endif %}

                    {% if block.settings.button_label != blank %}
                      <div class="ws-sticky-image-cards__actions">
                        <a
                          class="ws-sticky-image-cards__button"
                          {% if block.settings.button_link != blank %}
                            href="{{ block.settings.button_link }}"
                          {% else %}
                            role="link"
                            aria-disabled="true"
                          {% endif %}
                          {% if block.settings.open_in_new_tab and block.settings.button_link != blank %}
                            target="_blank"
                            rel="noopener noreferrer"
                          {% endif %}
                        >
                          {{ block.settings.button_label }}
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{{ 'ws-sticky-image-cards.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Sticky Image Cards",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "sticky_card",
      "name": "Sticky card",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "In Paris, SOJOS x OCEANUS took the runway, bringing ocean-inspired details and modern silhouettes to the spotlight. The show drew eyes from first step to finale-and the collection is now live to shop."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "PARIS FASHION WEEK EVENT"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "VIEW MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 video URL",
          "info": "Used when Shopify video is empty",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section shell"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Custom HTML ID for anchor links"
    },
    {
      "type": "text",
      "id": "content_max_width",
      "label": "Content max width",
      "default": "unset"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffc4d9"
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Text color",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse desktop layout",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_media_width",
      "label": "Desktop media width",
      "min": 40,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "row_height",
      "label": "Desktop row height",
      "default": "85vh"
    },
    {
      "type": "text",
      "id": "row_height_mobile",
      "label": "Mobile row height",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "sticky_top",
      "label": "Desktop sticky top",
      "default": "40px"
    },
    {
      "type": "text",
      "id": "sticky_top_mobile",
      "label": "Mobile sticky top",
      "default": "16px"
    },
    {
      "type": "text",
      "id": "gap",
      "label": "Gap",
      "default": "40px"
    },
    {
      "type": "text",
      "id": "media_aspect_ratio",
      "label": "Media aspect ratio",
      "default": "1 / 1"
    },
    {
      "type": "text",
      "id": "border_radius",
      "label": "Media border radius",
      "default": "34px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#ff3b81"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "text",
      "id": "padding_top_pc",
      "label": "PC padding top",
      "default": "40px"
    },
    {
      "type": "text",
      "id": "padding_bottom_pc",
      "label": "PC padding bottom",
      "default": "100px"
    },
    {
      "type": "text",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "default": "32px"
    },
    {
      "type": "text",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "default": "60px"
    },
    {
      "type": "text",
      "id": "margin_top_pc",
      "label": "PC margin top",
      "default": "0"
    },
    {
      "type": "text",
      "id": "margin_bottom_pc",
      "label": "PC margin bottom",
      "default": "0"
    },
    {
      "type": "text",
      "id": "margin_top_mobile",
      "label": "Mobile margin top",
      "default": "0"
    },
    {
      "type": "text",
      "id": "margin_bottom_mobile",
      "label": "Mobile margin bottom",
      "default": "0"
    }
  ],
  "presets": [
    {
      "name": "Sticky Image Cards",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "sticky_card",
          "settings": {
            "heading": "PARIS FASHION WEEK EVENT",
            "description": "In Paris, SOJOS x OCEANUS took the runway, bringing ocean-inspired details and modern silhouettes to the spotlight. The show drew eyes from first step to finale-and the collection is now live to shop.",
            "button_label": "VIEW MORE"
          }
        },
        {
          "type": "sticky_card",
          "settings": {
            "heading": "MIAMI SWIM WEEK EVENT",
            "description": "In June 2025, SOJOS debuted its upcoming styles at Miami Swim Week, capturing the essence of summer with fresh, vibrant designs. The runway was filled with excitement, as guests admired the innovative collections, eagerly anticipating their release.",
            "button_label": "VIEW MORE"
          }
        },
        {
          "type": "sticky_card",
          "settings": {
            "heading": "NEW YORK INFLUENCER EVENT",
            "description": "In May 2025, SOJOS joined The Summer Edit event in New York, presenting its latest Collections: Ocean Collection, Party Collection and Designer Collection. The launch captured the attention of top fashion influencers, with the new styles receiving overwhelming love.",
            "button_label": "VIEW MORE"
          }
        },
        {
          "type": "sticky_card",
          "settings": {
            "heading": "CHICAGO INFLUENCER EVENT",
            "description": "SOJOS participated in the Summer in the City event in Chicago in June 2024, showcasing its latest eyewear collections. SOJOS was well-received by creators, with strong appreciation for the designs.",
            "button_label": "VIEW MORE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
